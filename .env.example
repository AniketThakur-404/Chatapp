# WhatsApp Configuration
VERIFY_TOKEN=CarBot2025
ACCESS_TOKEN=your_meta_whatsapp_access_token
PHONE_NUMBER_ID=789143067615427

# Optional
PORT=3000

# Performance / logging
# Reduce payload logging in production
LOG_WEBHOOK_BODY=false
# WhatsApp API send tuning (reduce latency and timeouts)
WA_API_TIMEOUT_MS=10000
WA_API_RETRY_COUNT=2
WA_API_RETRY_DELAY_MS=400
# Max time to wait before responding to Meta webhook
WA_WEBHOOK_SEND_TIMEOUT_MS=7000
# WhatsApp message size safeguards
WA_TEXT_MAX_LEN=3500
WA_INTERACTIVE_BODY_MAX_LEN=900
# Google Sheets formatting
SHEET_TEXT_MAX_LEN=900
# Fast-fail + queue mode (respond instantly, retry in background)
WA_FAST_FAIL_QUEUE=true
WA_ALLOW_SERVERLESS_QUEUE=false
WA_FAST_FAIL_MS=2500
WA_QUEUE_MAX=200
WA_QUEUE_RETRY_LIMIT=5
WA_QUEUE_RETRY_BASE_DELAY_MS=1500
WA_QUEUE_CONCURRENCY=1
# Metrics
METRICS_MAX_SAMPLES=500

# Google Sheets Sync (optional)
# Enable real-time lead updates into a Google Sheet.
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_SHEET_NAME=Leads
# Provide ONE of the following credentials:
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}'
# GOOGLE_SERVICE_ACCOUNT_B64=base64_of_service_account_json
# GOOGLE_SERVICE_ACCOUNT_FILE=path/to/service-account.json
# Or use OAuth client credentials (requires a refresh token):
# GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
# GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/oauth2callback
# GOOGLE_OAUTH_REFRESH_TOKEN=your_google_oauth_refresh_token
